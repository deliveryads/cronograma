{
  "name": "Azulterra",
  "dataColors": ["#7AE582", "#F2C75C", "#F2857E", "#F0A77C", "#25A1BE", "#9FFFCB", "#00A5CF", "#B9A995"],
  "background": "#152739",
  "foreground": "#FFFAF3",
  "tableAccent": "#F0A77C",
  "good": "#7AE582",
  "neutral": "#F2C75C",
  "bad": "#F2857E",
  "textClasses": {
    "callout": {"fontFace": "Segoe UI Bold", "fontSize": 28, "color": "#FFFAF3"},
    "title": {"fontFace": "Segoe UI Semibold", "fontSize": 13, "color": "#FFFAF3"},
    "header": {"fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#ECDCC7"},
    "label": {"fontFace": "Segoe UI", "fontSize": 11, "color": "#ECDCC7"}
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{"color": {"solid": {"color": "#0E1B29"}}, "transparency": 0}],
        "outspace": [{"color": {"solid": {"color": "#0E1B29"}}, "transparency": 0}],
        "outspacePane": [{"backgroundColor": {"solid": {"color": "#152739"}}, "foregroundColor": {"solid": {"color": "#FFFAF3"}}, "borderColor": {"solid": {"color": "#2B4561"}}}]
      }
    },
    "*": {
      "*": {
        "background": [{"show": true, "color": {"solid": {"color": "#152739"}}, "transparency": 0}],
        "border": [{"show": false}],
        "title": [{"fontColor": {"solid": {"color": "#FFFAF3"}}}],
        "visualHeader": [{"background": {"solid": {"color": "#152739"}}, "foreground": {"solid": {"color": "#ECDCC7"}}}],
        "dropShadow": [{"show": false}]
      }
    },
    "slicer": {
      "*": {
        "background": [{"show": false}],
        "header": [{"fontColor": {"solid": {"color": "#ECDCC7"}}, "textSize": 9, "fontFamily": "Segoe UI Semibold"}],
        "items": [{"fontColor": {"solid": {"color": "#FFFAF3"}}, "background": {"solid": {"color": "#1C3147"}}, "outline": "None", "textSize": 10}]
      }
    },
    "image": {"*": {"background": [{"show": false}]}},
    "textbox": {"*": {"background": [{"show": false}]}},
    "pageNavigator": {
      "*": {
        "background": [{"show": false}],
        "fill": [{"show": true, "fillColor": {"solid": {"color": "#152739"}}, "transparency": 0}],
        "text": [{"fontColor": {"solid": {"color": "#FFFAF3"}}, "fontSize": 11, "fontFamily": "Segoe UI Semibold", "horizontalAlignment": "left"}],
        "outline": [{"show": false}]
      }
    }
  }
}
